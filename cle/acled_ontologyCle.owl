@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix conf: <http://data-semantics-2526.org/acled/ontology#> .
@prefix res:  <http://data-semantics-2526.org/acled/resource/> .

# ==========================================
# DICHIARAZIONE ONTOLOGIA
# ==========================================
<http://data-semantics-2526.org/acled/ontology>
    a owl:Ontology ;
    rdfs:label "ACLED Conflict Knowledge Graph Ontology" ;
    rdfs:comment "Progetto Data Semantics 2025/2026" .

# ==========================================
# SOTTOCLASSI DI ACTOR
# ==========================================

conf:StateForces
    a owl:Class ;
    rdfs:subClassOf conf:Actor ;
    rdfs:label "State Forces" .

conf:RebelGroup
    a owl:Class ;
    rdfs:subClassOf conf:Actor ;
    rdfs:label "Rebel Group" .

conf:PoliticalMilitia
    a owl:Class ;
    rdfs:subClassOf conf:Actor ;
    rdfs:label "Political Militia" .

conf:IdentityMilitia
    a owl:Class ;
    rdfs:subClassOf conf:Actor ;
    rdfs:label "Identity Militia" .

conf:Rioters
    a owl:Class ;
    rdfs:subClassOf conf:Actor ;
    rdfs:label "Rioters" .

conf:Protesters
    a owl:Class ;
    rdfs:subClassOf conf:Actor ;
    rdfs:label "Protesters" .

conf:Civilian
    a owl:Class ;
    rdfs:subClassOf conf:Actor ;
    rdfs:label "Civilian" .

conf:ExternalOther
    a owl:Class ;
    rdfs:subClassOf conf:Actor ;
    rdfs:label "External or Other Forces" .
# ==========================================
# OBJECT PROPERTIES
# ==========================================

conf:hasActor1
    a owl:ObjectProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  conf:Actor ;
    rdfs:label  "has actor 1" .

conf:hasActor2
    a owl:ObjectProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  conf:Actor ;
    rdfs:label  "has actor 2" .

conf:locatedIn
    a owl:ObjectProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  conf:Country ;
    rdfs:label  "located in" .

conf:reportedBy
    a owl:ObjectProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  conf:Source ;
    rdfs:label  "reported by" .



# ==========================================
# DATA PROPERTIES — ConflictEvent
# ==========================================

conf:eventDate
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:date ;
    rdfs:label  "event date" .

conf:disorderType
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "disorder type" .

conf:eventType
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "event type" .

conf:subEventType
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "sub event type" .

conf:fatalities
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:integer ;
    rdfs:label  "fatalities" .

conf:notes
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "notes" .

conf:tags
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "tags" .

conf:locationName
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "location name" .

conf:latitude
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "latitude" .

conf:longitude
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "longitude" .

conf:sourceScale
    a owl:DatatypeProperty ;
    rdfs:domain conf:ConflictEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "source scale" .

# ==========================================
# DATA PROPERTIES — Actor
# ==========================================

conf:actorName
    a owl:DatatypeProperty ;
    rdfs:domain conf:Actor ;
    rdfs:range  xsd:string ;
    rdfs:label  "actor name" .

# ==========================================
# DATA PROPERTIES — Country
# ==========================================

conf:countryName
    a owl:DatatypeProperty ;
    rdfs:domain conf:Country ;
    rdfs:range  xsd:string ;
    rdfs:label  "country name" .

conf:isoCode
    a owl:DatatypeProperty ;
    rdfs:domain conf:Country ;
    rdfs:range  xsd:integer ;
    rdfs:label  "ISO 3166 numeric code" .

# ==========================================
# DATA PROPERTIES — Source
# ==========================================

conf:sourceName
    a owl:DatatypeProperty ;
    rdfs:domain conf:Source ;
    rdfs:range  xsd:string ;
    rdfs:label  "source name" .